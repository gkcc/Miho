{
  "name": "miho-endgame-workspace",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.19.0 <25",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "deps:install": "pnpm install --frozen-lockfile",
    "build": "pnpm --filter miho-desktop build",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_rust_app.ps1 -Release",
    "tauri:build:no-bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_rust_app.ps1 -Release -NoBundle"
  }
}
