{
  "name": "miho-endgame-workspace",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.19.0 <25",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "deps:install": "pnpm install --frozen-lockfile",
    "build": "pnpm --filter miho-desktop build",
    "tauri:build:no-bundle": "pnpm --filter miho-desktop tauri build --no-bundle"
  }
}
